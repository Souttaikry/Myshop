# Copy this file to .env and fill in your real values

# MongoDB connection string (MongoDB Atlas or local)
# Local example:   mongodb://127.0.0.1:27017/stockdb
# Atlas example:   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/stockdb
MONGO_URI=mongodb://127.0.0.1:27017/stockdb

# Secret used to sign login tokens - change this to a long random string
JWT_SECRET=jbae nnhw xhkg inkl

# Port the server runs on
PORT=5000

# Default admin account created by "npm run seed"
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

# ---- Email verification codes ----
# Fill these in so the 6-digit code is really emailed to the customer.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
# SMTP_PASS=<a Google "App password", not your normal password>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=jbae nnhw xhkg inkl
MAIL_FROM=souttaikry099@gmail.com
# Local testing only: show the code inside the popup (never use in production)
SHOW_CODE_ON_SCREEN=false
# Local testing only: print the code in the terminal instead of emailing it
DEV_CONSOLE_CODE=false
